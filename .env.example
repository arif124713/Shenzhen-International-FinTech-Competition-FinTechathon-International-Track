# Copy to .env. Never commit real keys. All paths are repo-relative.
# --- LLM ---
# replay = deterministic offline fixtures (default; used by tests, eval and the offline demo)
# openai_compat = any OpenAI-compatible /chat/completions endpoint (DeepSeek, OpenAI, ...)
# anthropic = Anthropic Messages API
LLM_PROVIDER=replay
LLM_API_KEY=
# DeepSeek (OpenAI-compatible). Set LLM_PROVIDER=openai_compat to use it live.
# NOTE: the model IDs below are UNVERIFIED PLACEHOLDERS (public sources disagreed on the current DeepSeek
# model names). Confirm the correct ID in the provider's official docs and with a one-call test before any
# live run; record the confirmed ID + date in docs/execution_evidence/llm_config.md.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL_READER=deepseek-v4.1-flash
LLM_MODEL_PLANNER=deepseek-v4.1-flash
LLM_MODEL_COMPILER=deepseek-v4.1-flash
LLM_TEMPERATURE=0

# --- App ---
DATABASE_URL=sqlite:///./mandate.db
DEMO_MODE=1
SANDBOX_BANNER=Simulated - no real money moves
COOLING_OFF_HOURS_DEFAULT=24
EVAL_SEED=1337
